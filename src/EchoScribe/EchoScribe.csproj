<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>EchoScribe</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.1.0</Version>
    <Authors>ellinforest</Authors>
    <Description>实时语音转文字桌面工具 - 捕获 Windows 应用程序音频并使用 AI 实时转录为中文文字</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- GUI: Fluent Design for WPF -->
    <PackageReference Include="WPF-UI" Version="4.*" />
    
    <!-- MVVM Framework -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />
    
    <!-- ASR: sherpa-onnx speech recognition -->
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.*" />
    
    <!-- Audio: NAudio for WASAPI and resampling -->
    <PackageReference Include="NAudio" Version="2.*" />
    
    <!-- Dependency Injection -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.*" />
  </ItemGroup>

</Project>
