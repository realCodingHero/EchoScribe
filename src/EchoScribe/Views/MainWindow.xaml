<ui:FluentWindow x:Class="EchoScribe.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:EchoScribe.ViewModels"
        xmlns:controls="clr-namespace:EchoScribe.Views.Controls"
        Title="EchoScribe — 实时语音转文字"
        Width="900" Height="650"
        MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <ui:FluentWindow.DataContext>
        <vm:MainViewModel />
    </ui:FluentWindow.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 标题栏 -->
            <RowDefinition Height="Auto" />
            <!-- 主内容 -->
            <RowDefinition Height="*" />
            <!-- 状态栏 -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ====== 自定义标题栏 ====== -->
        <ui:TitleBar Grid.Row="0"
                     Title="EchoScribe"
                     ShowMaximize="True"
                     ShowMinimize="True" />

        <!-- ====== 主内容区域 ====== -->
        <Grid Grid.Row="1" Margin="16,8,16,8">
            <Grid.RowDefinitions>
                <!-- 控制面板 -->
                <RowDefinition Height="Auto" />
                <!-- 转录显示区 -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ====== 控制面板 ====== -->
            <Border Grid.Row="0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 第一行：进程选择 + 控制按钮 -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 进程标签 -->
                        <TextBlock Grid.Column="0"
                                   Text="🎯 目标进程"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                        <!-- 进程下拉框 -->
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AudioProcesses}"
                                  SelectedItem="{Binding SelectedProcess}"
                                  DisplayMemberPath="DisplayName"
                                  IsEnabled="{Binding IsTranscribing, Converter={StaticResource InverseBoolConverter}}"
                                  Margin="0,0,8,0" />

                        <!-- 刷新按钮 -->
                        <ui:Button Grid.Column="2"
                                   Icon="{ui:SymbolIcon ArrowSync24}"
                                   Command="{Binding RefreshProcessListCommand}"
                                   ToolTip="刷新进程列表"
                                   Margin="0,0,8,0"
                                   Appearance="Secondary" />

                        <!-- 开始按钮 -->
                        <ui:Button Grid.Column="3"
                                   Content="▶ 开始转录"
                                   Command="{Binding StartTranscriptionCommand}"
                                   Appearance="Primary"
                                   Margin="0,0,4,0"
                                   MinWidth="100" />

                        <!-- 停止按钮 -->
                        <ui:Button Grid.Column="4"
                                   Content="■ 停止"
                                   Command="{Binding StopTranscriptionCommand}"
                                   Appearance="Danger"
                                   Margin="0,0,4,0"
                                   MinWidth="80" />

                        <!-- 导出按钮 -->
                        <ui:Button Grid.Column="5"
                                   Icon="{ui:SymbolIcon ArrowDownload24}"
                                   Content="导出"
                                   Command="{Binding ExportTranscriptionCommand}"
                                   Appearance="Secondary" />
                    </Grid>

                    <!-- 第二行：麦克风 + 音频电平 -->
                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 麦克风开关 -->
                        <TextBlock Grid.Column="0"
                                   Text="🎤 麦克风"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <ui:ToggleSwitch Grid.Column="1"
                                      IsChecked="{Binding IsMicrophoneEnabled}"
                                      Margin="0,0,12,0" />

                        <!-- 应用音频电平 -->
                        <TextBlock Grid.Column="2"
                                   Text="📢 应用音量"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <controls:AudioLevelMeter Grid.Column="3"
                                                  Level="{Binding AppAudioLevel}"
                                                  Height="8"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,16,0" />

                        <!-- 麦克风电平 -->
                        <TextBlock Grid.Column="4"
                                   Text="🎤 麦克风音量"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   FontSize="12"
                                   Visibility="{Binding IsMicrophoneEnabled, Converter={StaticResource BoolToVisibilityConverter}}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <controls:AudioLevelMeter Grid.Column="5"
                                                  Level="{Binding MicAudioLevel}"
                                                  Height="8"
                                                  VerticalAlignment="Center"
                                                  Visibility="{Binding IsMicrophoneEnabled, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>
                </Grid>
            </Border>

            <!-- ====== 转录显示区 ====== -->
            <Border Grid.Row="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8"
                    Padding="0">

                <Grid>
                    <!-- 转录内容列表 -->
                    <ListBox x:Name="TranscriptionList"
                             ItemsSource="{Binding TranscriptionEntries}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="8"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,4,4,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 时间戳 -->
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding TimestampDisplay}"
                                               FontFamily="Consolas"
                                               FontSize="12"
                                               Foreground="{StaticResource AccentSecondary}"
                                               VerticalAlignment="Top"
                                               Margin="0,2,12,0"
                                               Opacity="0.8" />

                                    <!-- 转录文本 -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Text}"
                                               TextWrapping="Wrap"
                                               FontSize="15"
                                               LineHeight="24"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 空状态 / 下载进度 -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="480"
                                Visibility="{Binding TranscriptionEntries.Count, Converter={StaticResource ZeroToVisibilityConverter}}">

                        <!-- 图标 -->
                        <TextBlock Text="{Binding IsDownloadingModel, Converter={StaticResource DownloadIconConverter}}"
                                   FontSize="48"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,16" />

                        <!-- 标题文字 -->
                        <TextBlock Text="{Binding ModelLoadingStatus}"
                                   FontSize="16"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" />

                        <!-- 下载进度区域 -->
                        <StackPanel Margin="0,16,0,0"
                                    Visibility="{Binding IsDownloadingModel, Converter={StaticResource BoolToVisibilityConverter}}">

                            <!-- 进度条 -->
                            <ProgressBar Value="{Binding DownloadProgress}"
                                         Maximum="100"
                                         Height="6"
                                         Margin="0,0,0,8" />

                            <!-- 进度文本 -->
                            <TextBlock Text="{Binding DownloadProgressText}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       HorizontalAlignment="Center" />

                            <!-- 取消按钮 -->
                            <ui:Button Content="取消下载"
                                       Command="{Binding CancelDownloadCommand}"
                                       Appearance="Secondary"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,0" />
                        </StackPanel>

                        <!-- 下载失败时的重试按钮 -->
                        <ui:Button Content="🔄 重新下载模型"
                                   Command="{Binding RetryDownloadModelsCommand}"
                                   Appearance="Primary"
                                   HorizontalAlignment="Center"
                                   Margin="0,16,0,0"
                                   Visibility="{Binding IsModelLoaded, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

                        <!-- 就绪提示 -->
                        <TextBlock Text="选择一个应用程序，点击「开始转录」"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,0"
                                   Visibility="{Binding IsModelLoaded, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ====== 状态栏 ====== -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 状态消息 -->
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <!-- GPU 信息 -->
                <Border Grid.Column="1"
                        Background="{StaticResource AccentPrimary}"
                        CornerRadius="4"
                        Padding="8,2"
                        Margin="8,0"
                        Opacity="0.8">
                    <TextBlock Text="{Binding GpuInfo}"
                               FontSize="11"
                               Foreground="White"
                               VerticalAlignment="Center" />
                </Border>

                <!-- 清空按钮 -->
                <ui:Button Grid.Column="2"
                           Content="清空"
                           Command="{Binding ClearTranscriptionCommand}"
                           Appearance="Secondary"
                           FontSize="11"
                           Padding="8,2" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
